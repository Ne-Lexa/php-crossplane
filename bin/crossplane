#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $file) {
    if (file_exists($file)) {
        require $file;
        break;
    }
}

$name = basename(__FILE__);

$logo = <<<'TEXT'
____ ____ ____ ___  ___  ____ __   ___  __   ____ 
| __\| . \|   || _\ | _\ | . \| |  |  \ | \|\| __\
| \__|  <_| . |[__ \[__ \| __/| |__| . \|  \||  ]_
|___/|/\_/|___/|___/|___/|/   |___/|/\_/|/\_/|___/


TEXT;

$application = new \Nelexa\NginxParser\Console\Application($name, $logo);
$application->addCommands([
    new \Nelexa\NginxParser\Console\Command\LexCommand(),
    new \Nelexa\NginxParser\Console\Command\ParseCommand(),
    new \Nelexa\NginxParser\Console\Command\BuildCommand(),
    new \Nelexa\NginxParser\Console\Command\MinifyCommand(),
    new \Nelexa\NginxParser\Console\Command\FormatCommand(),
]);
$application->run();
